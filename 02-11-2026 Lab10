import matplotlib.pyplot as plt

months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']
sales = [15000, 18000, 16500, 22000, 25000, 24000]

plt.figure(figsize=(14, 5))

# 1. Line Plot
plt.subplot(1, 2, 1)
plt.plot(months, sales, marker='o', color='b', linestyle='-', linewidth=2)
plt.title('Monthly Sales Trend (Line Plot)')
plt.xlabel('Month')
plt.ylabel('Sales ($)')
plt.grid(True, linestyle='--', alpha=0.6)

# 2. Bar Plot
plt.subplot(1, 2, 2)
plt.bar(months, sales, color='teal', alpha=0.85)
plt.title('Monthly Sales Distribution (Bar Plot)')
plt.xlabel('Month')
plt.ylabel('Sales ($)')
plt.grid(axis='y', linestyle='--', alpha=0.6)

plt.tight_layout()
plt.show()
